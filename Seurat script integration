names(list.data) <- NamesProject

list.dataPurif <- list()
for (i in 1:length(list.data)) {
  list.dataPurif[[i]] <- subset(list.data[[i]], subset = nCount_RNA > 10000 & nFeature_RNA > 1650 & nCount_RNA < 150000 & nFeature_RNA < 10000 & percent.mt < 5)
}


# Cell names was not changed before integration which was a mistakes. As a results ctr4h cells are renamed by seurat with the barcode _1
# cut4h barecode is renamed with _2 and so on. This is a problem for the integration because seurat will not be able to find the same cell in the two datasets. So I need to rename the cells in each dataset with the same name as the project name and the barcode without the suffix _1, _2, _3, _4, _5, _6, _7, _8 and _9.
# this aws not done in the puublished dataset I think 
listnames <- list()

for (i in 1:length(list.dataPurif)) {
  listnames[[i]] <- WhichCells(list.dataPurif[[i]])
  listnames[[i]] <- str_remove(listnames[[i]], "-1")
  listnames[[i]] <- paste(NamesProject[i],listnames[[i]], sep = "_")
  list.dataPurif[[i]] <- RenameCells(list.dataPurif[[i]], new.names = listnames[[i]])
}


names(list.dataPurif) <- NamesProject
save(list.dataPurif, file = "Seurat object not integrated expression matrices root regeneration.RData")

# integrate using the SCT transform method.

ctrcut.listSCT <- list.dataPurif

for (i in 1:length(list.dataPurif)) {
  ctrcut.listSCT[[i]] <- SCTransform(ctrcut.listSCT[[i]], verbose = TRUE)
  
}


#to avoid the usual error of the size limit suing the PrepSCTIntegration
options(future.globals.maxSize = 13000 * 1024^2)

#
ctrcut.features <- SelectIntegrationFeatures(object.list = ctrcut.listSCT, nfeatures = 3000)
ctrcut.list <- PrepSCTIntegration(object.list = ctrcut.listSCT, anchor.features = ctrcut.features)

# We set up the reference ctr cells to map the cut ones in order they are c("Ctr4h","Cut4h","Ctr914","Ctr224","Cut9h","Cut14h","Cut24h","CTR36h","CUT36H")
reference_datasetSCT <- c(1,3,4,8) 

pbmc.anchorsSCT <- FindIntegrationAnchors(object.list = ctrcut.list, normalization.method = "SCT", 
                                          anchor.features = ctrcut.features, reference = reference_datasetSCT)
pbmc.integratedSCT <- IntegrateData(anchorset = pbmc.anchorsSCT, normalization.method = "SCT", dims = 1:100)

pbmc.integratedSCTREF <- RunPCA(pbmc.integratedSCT, npcs = 100, verbose = FALSE)

pbmc.integratedSCTREF <- RunTSNE(object = pbmc.integratedSCTREF, dims = 1:30)

pbmc.integratedSCTREF = FindNeighbors(object = pbmc.integratedSCTREF,  dims = 1:30, reduction = "pca", assay = "integrated", verbose = T, force.recalc = T)
#below the resolution depends on how many cluster you want to add, the higher the resolution is the more cluster you find
# the "correct amount of cluster" can be define by the biology and how many cell type do we expect.
pbmc.integrated_SCTREF2 = FindClusters(object = pbmc.integratedSCTREF, resolution = 0.8, verbose = T)
pbmc.integrated_SCTREF2 <- RunUMAP(pbmc.integratedSCTREF2, dims = 1:100)

graph <- DimPlot(pbmc.integrated_SCTREF2, label = T)

pdf("Umap_pbmc.integrated_SCTREF_integration_Res08_Clusters.pdf", width = 9, height = 8)
print(graph)
dev.off()


